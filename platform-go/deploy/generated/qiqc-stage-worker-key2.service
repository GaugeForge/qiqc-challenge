[Unit]
Description=QIQC local staging worker-key2
After=network.target qiqc-stage-scanner.service

[Service]
Type=simple
User=qiqc-stage-worker
Group=qiqc-stage-data
Environment=QIQC_SHARED_DATA=1
Environment=QIQC_MODEL=tencent/hy4
Environment=QIQC_BASELINE=/opt/qiqc-staging/current/baseline-astra-39.json
WorkingDirectory=/opt/qiqc-staging/current
ReadWritePaths=/var/lib/qiqc-staging/data
InaccessiblePaths=-/run/docker.sock -/var/run/docker.sock
Environment=QIQC_R2_ENABLED=1
Environment=QIQC_R2_ENV=/etc/qiqc-staging/worker-key2-r2.env
SupplementaryGroups=qiqc-stage-science
Environment=QIQC_PROJECT_ROOT=/opt/qiqc-staging/science
Environment=QIQC_E2B_KEY_FILE=/etc/qiqc-staging/worker-e2b.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=QIQC_WORKER_POOL=key2
Environment=HF_HUB_DISABLE_TELEMETRY=1
ExecStart=/opt/qiqc-staging/current/worker -data /var/lib/qiqc-staging/data -slots 20 -science-project /opt/qiqc-staging/science -science-python /opt/qiqc-staging/venv/bin/python -model-gateway http://127.0.0.1:18889
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0007
Restart=on-failure
RestartSec=2
TimeoutStopSec=480

[Install]
WantedBy=multi-user.target
