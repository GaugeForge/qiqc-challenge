[Unit]
Description=QIQC legacy test fixture legacy-python-api
After=network.target docker.service

[Service]
Type=simple
WorkingDirectory=/root/QQ-Challenge/competition-platform
Environment=PYTHONPATH=/root/QQ-Challenge/competition-platform/platform
Environment=QIQC_DATA=/root/QQ-Challenge/runtime/legacy-platform-data
Environment=QIQC_R2_ENABLED=1
Environment=QIQC_BASELINE=/root/QQ-Challenge/benchmark-assets/baseline-mock.json
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/root/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/root/QQ-Challenge/competition-platform/platform/.venv/bin/python -m uvicorn qiqc.app:factory --factory --host 127.0.0.1 --port 8765 --no-access-log
Restart=on-failure
RestartSec=3
TimeoutStopSec=390
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
